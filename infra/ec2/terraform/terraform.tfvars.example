aws_region            = "ap-southeast-1"
project_name          = "mlops"
environment           = "labs"
key_name              = "mlops-labs-key"
s3_bucket             = "mlops-labs-YOUR_ACCOUNT_ID"
allowed_ssh_cidr      = "YOUR.PUBLIC.IP/32"
allowed_app_cidr      = "YOUR.PUBLIC.IP/32"
enable_gpu_node       = true
use_spot_gpu          = true
control_instance_type = "t3.xlarge"
gpu_instance_type     = "g4dn.xlarge"
